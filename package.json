{
  "name": "dsh-completion-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codex-style completion card for DeepSeek Harness: when a conversation finishes in the background, show a themed card with the session, a snippet of the answer, and click-to-open.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hz106/dsh-completion-notify.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "toast"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "toast.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
